{
  "name": "@warden/core",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./keyring": {
      "types": "./dist/keyring/index.d.ts",
      "import": "./dist/keyring/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./approval": {
      "types": "./dist/approval/index.d.ts",
      "import": "./dist/approval/index.js"
    },
    "./transaction": {
      "types": "./dist/transaction/index.d.ts",
      "import": "./dist/transaction/index.js"
    },
    "./transaction/session": {
      "types": "./dist/transaction/session-transaction.d.ts",
      "import": "./dist/transaction/session-transaction.js"
    },
    "./transaction/session-approval": {
      "types": "./dist/transaction/session-approval-coordinator.d.ts",
      "import": "./dist/transaction/session-approval-coordinator.js"
    },
    "./transaction/session-intent": {
      "types": "./dist/transaction/session-intent.d.ts",
      "import": "./dist/transaction/session-intent.js"
    },
    "./transaction/session-authority": {
      "types": "./dist/transaction/session-authority-resolver.d.ts",
      "import": "./dist/transaction/session-authority-resolver.js"
    },
    "./transaction/session-rpc": {
      "types": "./dist/transaction/session-rpc.d.ts",
      "import": "./dist/transaction/session-rpc.js"
    },
    "./transaction/session-release": {
      "types": "./dist/transaction/session-release.d.ts",
      "import": "./dist/transaction/session-release.js"
    }
  },
  "files": [
    "dist",
    "idl"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-deploy-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:fixtures": "tsx scripts/gen-fixtures.ts"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "2.4.0",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "tsx": "^4.23.12"
  }
}
