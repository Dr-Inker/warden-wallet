{
  "name": "@warden/core",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./keyring": {
      "types": "./dist/keyring/index.d.ts",
      "import": "./dist/keyring/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    }
  },
  "files": [
    "dist",
    "idl"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-deploy-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:fixtures": "tsx scripts/gen-fixtures.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@noble/curves": "^1.9.7",
    "ajv": "^8.20.0",
    "tsx": "^4.23.12"
  }
}
